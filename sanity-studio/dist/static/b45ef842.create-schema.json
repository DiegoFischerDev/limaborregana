[
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "name": "title",
        "type": "string",
        "title": "Título"
      },
      {
        "options": {
          "source": "title",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Identificador único para o URL (ex: golden-visa). Gera a partir do título.",
        "name": "slug",
        "type": "slug",
        "title": "Slug (URL)"
      },
      {
        "options": {
          "hotspot": true
        },
        "name": "mainImage",
        "type": "image",
        "title": "Imagem principal"
      },
      {
        "rows": 3,
        "validation": [
          {
            "rules": [
              {
                "flag": "max",
                "constraint": 300
              }
            ],
            "level": "error"
          }
        ],
        "description": "Texto curto que aparece nos cards e na pré-visualização.",
        "name": "excerpt",
        "type": "text",
        "title": "Resumo"
      },
      {
        "name": "publishedAt",
        "type": "datetime",
        "title": "Data de publicação"
      },
      {
        "of": [
          {
            "marks": {
              "annotations": [
                {
                  "i18nTitleKey": "inputs.portable-text.annotation.link",
                  "options": {
                    "modal": {
                      "type": "popover"
                    }
                  },
                  "fields": [
                    {
                      "validation": [
                        {
                          "rules": [
                            {
                              "flag": "uri",
                              "constraint": {
                                "options": {
                                  "scheme": [
                                    "/^http$/",
                                    "/^https$/",
                                    "/^tel$/",
                                    "/^mailto$/"
                                  ],
                                  "allowRelative": true,
                                  "relativeOnly": false,
                                  "allowCredentials": false
                                }
                              }
                            }
                          ],
                          "level": "error"
                        }
                      ],
                      "description": "A valid web, email, phone, or relative link.",
                      "name": "href",
                      "type": "url",
                      "title": "Link"
                    }
                  ],
                  "name": "link",
                  "type": "object"
                }
              ],
              "decorators": [
                {
                  "value": "strong",
                  "title": "Strong"
                },
                {
                  "value": "em",
                  "title": "Italic"
                },
                {
                  "value": "code",
                  "title": "Code"
                },
                {
                  "value": "underline",
                  "title": "Underline"
                },
                {
                  "value": "strike-through",
                  "title": "Strike"
                }
              ]
            },
            "lists": [
              {
                "value": "bullet",
                "title": "Bulleted list"
              },
              {
                "value": "number",
                "title": "Numbered list"
              }
            ],
            "styles": [
              {
                "value": "normal",
                "title": "Normal"
              },
              {
                "value": "h1",
                "title": "Heading 1"
              },
              {
                "value": "h2",
                "title": "Heading 2"
              },
              {
                "value": "h3",
                "title": "Heading 3"
              },
              {
                "value": "h4",
                "title": "Heading 4"
              },
              {
                "value": "h5",
                "title": "Heading 5"
              },
              {
                "value": "h6",
                "title": "Heading 6"
              },
              {
                "value": "blockquote",
                "title": "Quote"
              }
            ],
            "of": [],
            "type": "block"
          },
          {
            "options": {
              "hotspot": true
            },
            "type": "image"
          }
        ],
        "name": "body",
        "type": "array",
        "title": "Corpo do artigo"
      }
    ],
    "name": "post",
    "type": "document",
    "title": "Artigo"
  }
]